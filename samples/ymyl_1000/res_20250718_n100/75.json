      "question": "What are the 7 types of arthritis?",
      "type": "ai_overview",
      "text_blocks": [
        {
          "type": "paragraph",
          "snippet": "There are more than 100 different types of arthritis, but some of the most common include osteoarthritis, rheumatoid arthritis, gout, psoriatic arthritis, ankylosing spondylitis, juvenile arthritis, and lupus. These conditions all involve joint pain and inflammation, but they differ in their causes, symptoms, and affected areas.",
          "snippet_highlighted_words": [
            "osteoarthritis, rheumatoid arthritis, gout, psoriatic arthritis, ankylosing spondylitis, juvenile arthritis, and lupus"
          ],
          "reference_indexes": [
            1,
            4,
            6,
            7
          ]
        },
        {
          "type": "heading",
          "snippet": "Here's a brief overview of each:"
        },
        {
          "type": "list",
          "list": [
            {
              "title": "Osteoarthritis (OA):",
              "snippet": "The most common type, OA is caused by the breakdown of cartilage in joints, leading to bone-on-bone friction.",
              "reference_indexes": [
                1,
                3,
                4,
                7
              ]
            },
            {
              "title": "Rheumatoid Arthritis (RA):",
              "snippet": "An autoimmune disorder where the body's immune system attacks the lining of the joints.",
              "reference_indexes": [
                4,
                5
              ]
            },
            {
              "title": "Gout:",
              "snippet": "A metabolic condition caused by a buildup of uric acid crystals in the joints, often affecting the big toe.",
              "reference_indexes": [
                4,
                6
              ]
            },
            {
              "title": "Psoriatic Arthritis (PsA):",
              "snippet": "An inflammatory arthritis associated with the skin condition psoriasis, affecting joints, skin, and nails.",
              "reference_indexes": [
                4,
                8
              ]
            },
            {
              "title": "Ankylosing Spondylitis:",
              "snippet": "Primarily affects the spine, causing inflammation and stiffness in the spinal joints.",
              "reference_indexes": [
                2,
                4,
                9
              ]
            },
            {
              "title": "Juvenile Arthritis (JA):",
              "snippet": "A group of inflammatory conditions affecting children and teens, with various subtypes.",
              "reference_indexes": [
                4,
                10
              ]
            },
            {
              "title": "Lupus:",
              "snippet": "An autoimmune disease that can affect various parts of the body, including the joints, skin, and organs.",
              "reference_indexes": [
                0,
                4
              ]
            }
          ]
        }
