      "question": "What is an EOP plan?",
      "type": "ai_overview",
      "text_blocks": [
        {
          "type": "paragraph",
          "snippet": "An Emergency Operations Plan (EOP) is a comprehensive document that outlines procedures and responsibilities for an organization to follow during emergencies or disasters. It's designed to protect people and property by detailing how to respond and recover from various threats. EOPs are adaptable, living documents that are regularly updated to reflect evolving circumstances and lessons learned.",
          "snippet_highlighted_words": [
            "a comprehensive document that outlines procedures and responsibilities for an organization to follow during emergencies or disasters"
          ],
          "reference_indexes": [
            0,
            2,
            5
          ]
        },
        {
          "type": "heading",
          "snippet": "Here's a more detailed breakdown:"
        },
        {
          "type": "list",
          "list": [
            {
              "title": "Purpose:",
              "snippet": "An EOP provides a framework for how an organization will respond to different crises, such as natural disasters, pandemics, or security threats.",
              "reference_indexes": [
                3,
                5
              ]
            },
            {
              "title": "Key Components:",
              "snippet": "EOPs typically include a basic plan outlining general policies and responsibilities, functional annexes for specific emergency functions, support annexes for essential processes, and hazard-specific annexes for unique response details.",
              "reference_indexes": [
                1,
                6
              ]
            },
            {
              "title": "Content:",
              "snippet": "EOPs detail personnel roles and responsibilities, resource allocation (equipment, facilities, supplies), communication protocols, evacuation procedures, and more.",
              "reference_indexes": [
                2,
                3,
                5
              ]
            },
            {
              "title": "Benefits:",
              "snippet": "EOPs ensure a structured and coordinated response, facilitate effective decision-making during emergencies, and help organizations prepare for and recover from various incidents.",
              "reference_indexes": [
                2,
                4
              ]
            },
            {
              "title": "Examples:",
              "snippet": "Hospitals, schools, counties, and other organizations all utilize EOPs to manage emergencies.",
              "reference_indexes": [
                3,
                4,
                5
              ]
            }
          ]
        }
