      "3": {
        "fact": "\u68c0\u6d4b\u65b9\u6cd5: \u4e0d\u540c\u7684\u68c0\u6d4b\u65b9\u6cd5\u6709\u4e0d\u540c\u7684\u7a97\u53e3\u671f\u3002\u6297\u4f53\u68c0\u6d4b\u7684\u7a97\u53e3\u671f\u901a\u5e38\u6bd4\u6297\u539f\u548c\u6838\u9178\u68c0\u6d4b\u7684\u7a97\u53e3\u671f\u8981\u957f\u3002",
