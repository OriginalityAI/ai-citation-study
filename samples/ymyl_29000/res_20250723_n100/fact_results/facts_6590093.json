      "1": {
        "fact": "\u5728\u8fd9\u4e2a\u65f6\u671f\uff0c\u5373\u4f7f\u8fdb\u884c\u4e86HIV\u68c0\u6d4b\uff0c\u4e5f\u53ef\u80fd\u56e0\u4e3a\u4f53\u5185\u75c5\u6bd2\u5c1a\u672a\u4ea7\u751f\u8db3\u591f\u7684\u6297\u4f53\u6216\u6297\u539f\u800c\u65e0\u6cd5\u88ab\u68c0\u6d4b\u5230\uff0c\u4f46\u4ecd\u7136\u5177\u6709\u4f20\u67d3\u6027\u3002",
        "truthfulness": 100,
        "explanation": "\u7a97\u53e3\u671f\u5185\u7531\u4e8e\u6297\u4f53\u6216\u6297\u539f\u5c1a\u672a\u8fbe\u5230\u68c0\u6d4b\u9608\u503c\uff0c\u68c0\u6d4b\u53ef\u80fd\u4e3a\u9634\u6027\uff0c\u4f46\u75c5\u6bd2\u5df2\u5b58\u5728\u4e14\u8f7d\u91cf\u9ad8\uff0c\u5177\u6709\u4f20\u67d3\u6027\u3002",
