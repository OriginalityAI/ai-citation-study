      "2": {
        "fact": "\u7a97\u53e3\u671f\u7684\u957f\u77ed\u56e0\u4eba\u800c\u5f02\uff0c\u4e5f\u4e0e\u68c0\u6d4b\u65b9\u6cd5\u6709\u5173\uff0c\u901a\u5e38\u57282\u523012\u5468\u5de6\u53f3\uff0c\u5e73\u574742\u5929\u3002",
        "truthfulness": 95,
        "explanation": "\u7a97\u53e3\u671f\u4e00\u822c\u4e3a2\u81f312\u5468\uff0c\u5e73\u5747\u7ea642\u5929\uff0c\u5177\u4f53\u65f6\u95f4\u53d7\u4e2a\u4f53\u5dee\u5f02\u548c\u68c0\u6d4b\u65b9\u6cd5\u5f71\u54cd\uff0c\u90e8\u5206\u8d44\u6599\u663e\u793a\u6297\u4f53\u68c0\u6d4b\u7a97\u53e3\u671f\u7ea63\u5468\uff0c\u6297\u539f\u548c\u6838\u9178\u68c0\u6d4b\u7a97\u53e3\u671f\u66f4\u77ed\u3002",
