      "0": {
        "fact": "\u827e\u6ecb\u75c5\u7a97\u53e3\u671f\u662f\u6307\u4ece\u611f\u67d3\u827e\u6ecb\u75c5\u75c5\u6bd2(HIV) \u5230\u8840\u6db2\u4e2d\u80fd\u68c0\u6d4b\u51faHIV\u6297\u4f53\u6216\u6297\u539f\u4e4b\u95f4\u7684\u8fd9\u6bb5\u65f6\u95f4\u3002",
        "truthfulness": 100,
        "explanation": "\u827e\u6ecb\u75c5\u7a97\u53e3\u671f\u5b9a\u4e49\u4e3a\u4ece\u611f\u67d3HIV\u5230\u4f53\u5185\u4ea7\u751f\u53ef\u68c0\u6d4b\u7684\u6297\u4f53\u6216\u6297\u539f\u7684\u65f6\u95f4\u6bb5\uff0c\u8fd9\u662f\u533b\u5b66\u4e0a\u5bf9\u7a97\u53e3\u671f\u7684\u6807\u51c6\u5b9a\u4e49\u3002",
