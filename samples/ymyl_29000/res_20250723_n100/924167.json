  "ai_overview": {
    "text_blocks": [
      {
        "type": "paragraph",
        "snippet": "The condition you're asking about is likely Sprengel deformity, a rare congenital disorder where the scapula (shoulder blade) is abnormally high and underdeveloped. It's not called \"Springles\" disease. Sprengel deformity is characterized by limited shoulder movement and can sometimes be associated with other skeletal abnormalities.",
        "snippet_highlighted_words": [
          "Sprengel deformity, a rare congenital disorder where the scapula (shoulder blade) is abnormally high and underdeveloped"
        ],
        "reference_indexes": [
          1,
          2,
          4
        ]
      },
      {
        "type": "heading",
        "snippet": "More details about Sprengel deformity:"
      },
      {
        "type": "list",
        "list": [
          {
            "title": "Cause:",
            "snippet": "It's believed to result from a failure of the scapula to descend to its normal position during fetal development.",
            "reference_indexes": [
              0
            ]
          },
          {
            "title": "Symptoms:",
            "snippet": "The most noticeable symptom is the elevated position of the scapula, often on one side of the body. This can restrict arm movement and cause pain or stiffness.",
            "reference_indexes": [
              1,
